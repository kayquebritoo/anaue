# Copie para .env.staging.local (ignorado pelo git) e preencha com o projeto de STAGING.
# NUNCA use valores do projeto de produção — o script recusa o ref de produção.
STAGING_SUPABASE_URL=https://<ref-do-staging>.supabase.co
STAGING_SUPABASE_ANON_KEY=sb_publishable_...
STAGING_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Opcional: usuários de teste criados no Auth do staging
STAGING_STAFF_EMAIL=
STAGING_STAFF_PASSWORD=
STAGING_NONSTAFF_EMAIL=
STAGING_NONSTAFF_PASSWORD=
